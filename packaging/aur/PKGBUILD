# Maintainer: Jyothi Prajith <101039137+jyothiprajith1323@users.noreply.github.com>
pkgname=termexplorer-git
pkgver=1.1.0.r1.g06f7e32
pkgrel=1
pkgdesc='Inspection-first terminal developer workstation written in Rust'
arch=('x86_64' 'aarch64')
url='https://github.com/jyothiprajith1323/TermExplorer'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'rust')
optdepends=(
  'git: Git integration'
  'ffmpeg: media metadata and frame extraction'
  'poppler: PDF text and metadata extraction'
  'trash-cli: FreeDesktop trash fallback'
)
provides=('termexplorer')
conflicts=('termexplorer')
source=("git+https://github.com/jyothiprajith1323/TermExplorer.git#branch=master")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/TermExplorer"
  base_version=$(sed -n 's/^version = \"\(.*\)\"$/\1/p' Cargo.toml | head -n 1)
  base_version=${base_version//-/.}
  printf '%s.r%s.g%s' "$base_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/TermExplorer"
  cargo fetch --locked
}

build() {
  cd "$srcdir/TermExplorer"
  cargo build --locked --release --all-features
}

check() {
  cd "$srcdir/TermExplorer"
  cargo test --locked --release --all-features
}

package() {
  cd "$srcdir/TermExplorer"
  install -Dm755 target/release/termexplorer "$pkgdir/usr/bin/termexplorer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 INSTALLATION.md "$pkgdir/usr/share/doc/$pkgname/INSTALLATION.md"
}
